# Copy to .env (gitignored) and fill in, or save Tiger Cloud's downloaded
# credentials file as .env. server.py and scripts/tiger_data.py load it at startup.
# Leave everything empty to run fully offline from the bundled data.

# Tiger Data (TimescaleDB). Either set the service URL...
TIMESCALE_SERVICE_URL=
# ...or QUAKETRACE_TIGER_DSN directly (it wins if both are set).
QUAKETRACE_TIGER_DSN=

# Standard PostgreSQL variables from Tiger's credentials file. PGPASSWORD is used
# when the service URL does not include the password.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Optional: Google Maps browser key for Map, Satellite and Earth 3D views.
GOOGLE_MAPS_API_KEY=
